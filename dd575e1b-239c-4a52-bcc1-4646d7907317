<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Phan Hoàng Nam – Giới thiệu bản thân</title>
<meta name="description" content="Trang giới thiệu của Phan Hoàng Nam, học sinh lớp 12A2 Trường THPT Hòn Gai, sinh 03/02/2009. Thích chơi game, tập bóng rổ và đi chơi cùng bạn bè.">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=DM+Sans:wght@400;500;600&display=swap">
<style>
:root{
  --bg:#efeaff; --card:#ffffff; --ink:#1b1638; --muted:#5b557a;
  --violet:#5a3df0; --on-violet:#ffffff; --lime:#cdf54a; --on-lime:#1b1638; --coral:#ff8a65; --on-coral:#2a1208;
  color-scheme:light; box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){--bg:#0f0c20; --card:#1c1838; --ink:#f1eeff; --muted:#b4aed6; color-scheme:dark}
}
:root[data-theme="dark"]{--bg:#0f0c20; --card:#1c1838; --ink:#f1eeff; --muted:#b4aed6; color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 17px/1.6 "DM Sans",system-ui,sans-serif}
h1,h2,h3{font-family:"Space Grotesk","Segoe UI",sans-serif;margin:0;line-height:1.1;font-weight:700}
.page{max-width:1040px;margin:0 auto;padding:20px 18px 56px}
.bar{display:flex;justify-content:space-between;align-items:center;padding:6px 6px 18px;font:500 15px "Space Grotesk",sans-serif}
.bar a{color:var(--ink);text-decoration:none;border-bottom:2px solid var(--violet)}
.bento{display:grid;grid-template-columns:repeat(12,1fr);gap:16px}
.card{background:var(--card);border-radius:28px;padding:28px;overflow:hidden}
.label{font:500 14px/1 "Space Grotesk",sans-serif;letter-spacing:.06em;text-transform:uppercase;opacity:.8;margin:0 0 14px}

.intro{grid-column:1/8;background:var(--violet);color:var(--on-violet);display:flex;flex-direction:column;justify-content:space-between;gap:26px;min-height:360px}
.intro h1{font-size:clamp(38px,6.2vw,66px);letter-spacing:-.02em}
.intro p{margin:14px 0 0;font-size:19px;max-width:30ch;opacity:.95}
.pill{display:inline-block;align-self:flex-start;background:var(--lime);color:var(--on-lime);font:700 16px/1 "Space Grotesk",sans-serif;padding:15px 24px;border-radius:999px;text-decoration:none}
.pill:hover{filter:brightness(1.06)}
.pill:focus-visible{outline:3px solid currentColor;outline-offset:3px}

.chips{list-style:none;margin:16px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:8px}
.chips li{background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.4);border-radius:999px;padding:7px 16px;font:500 15px/1.2 "Space Grotesk",sans-serif}
.photo{grid-column:8/13;grid-row:1/3;padding:0;position:relative;min-height:440px}
.photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 28%}

.dob{grid-column:1/5;background:var(--lime);color:var(--on-lime)}
.dob .big{font:700 clamp(44px,7vw,64px)/1 "Space Grotesk",sans-serif;letter-spacing:-.02em}
.dob .yr{font:500 22px "Space Grotesk",sans-serif;margin-top:6px}

.hobby{grid-column:5/8}
.hobby ol{list-style:none;margin:0;padding:0;display:grid;gap:10px;counter-reset:n}
.hobby li{counter-increment:n;display:flex;gap:12px;align-items:center;font:500 17px/1.3 "DM Sans",sans-serif;background:var(--bg);border-radius:16px;padding:11px 14px}
.hobby li::before{content:counter(n);flex:none;width:28px;height:28px;border-radius:50%;background:var(--violet);color:#fff;display:grid;place-items:center;font:700 14px "Space Grotesk",sans-serif}

.video{grid-column:1/9}
.video video{display:block;width:100%;aspect-ratio:16/9;background:#000;border-radius:18px}
.video .row{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:14px;flex-wrap:wrap}
.video .row span{color:var(--muted);font-size:15px}
.video a{color:var(--ink);font:500 15px "Space Grotesk",sans-serif;border-bottom:2px solid var(--violet);text-decoration:none}

.contact{grid-column:9/13;background:var(--coral);color:var(--on-coral);display:flex;flex-direction:column;justify-content:space-between;gap:22px}
.contact h2{font-size:30px}
.contact .pill{background:var(--on-coral);color:#fff}

footer{text-align:center;color:var(--muted);font-size:14px;padding-top:26px}

@media (max-width:860px){
  .intro,.photo,.dob,.hobby,.video,.contact{grid-column:1/-1;grid-row:auto}
  .intro{min-height:0}
  .photo{min-height:0;aspect-ratio:4/5}
}
</style>
</head>
<body>
<div class="page">
  <div class="bar"><span>Phan Hoàng Nam</span><a href="https://www.facebook.com/share/1FW5qvxm1U/?mibextid=wwXIfr" target="_blank" rel="noopener noreferrer">Facebook</a></div>

  <main class="bento">
    <section class="card intro" aria-labelledby="h-name">
      <div>
        <p class="label">Xin chào, mình là</p>
        <h1 id="h-name">Phan Hoàng Nam</h1>
        <ul class="chips"><li>Học sinh lớp 12A2</li><li>Trường THPT Hòn Gai</li></ul>
        <p>Thích chơi game, tập bóng rổ và đi chơi cùng bạn bè.</p>
      </div>
      <a class="pill" href="https://www.facebook.com/share/1FW5qvxm1U/?mibextid=wwXIfr" target="_blank" rel="noopener noreferrer">Kết bạn trên Facebook</a>
    </section>

    <figure class="card photo" style="margin:0"><img src="data:image/jpeg;base64," alt="Phan Hoàng Nam mặc áo đấu bóng rổ màu đen vàng, tạo dáng trước phông nền tối"></figure>

    <section class="card dob" aria-label="Ngày sinh">
      <p class="label">Ngày sinh</p>
      <div class="big">03/02</div>
      <div class="yr">2009</div>
    </section>

    <section class="card hobby" aria-labelledby="h-hobby">
      <p class="label" id="h-hobby">Sở thích</p>
      <ol>
        <li>Chơi game</li>
        <li>Tập bóng rổ</li>
        <li>Đi chơi cùng bạn bè</li>
      </ol>
    </section>

    <section class="card video" aria-labelledby="h-video">
      <p class="label" id="h-video">Video</p>
      <video controls playsinline preload="metadata" poster="data:image/jpeg;base64," aria-label="Video của Phan Hoàng Nam"><source src="data:video/mp4;base64," type="video/mp4">Trình duyệt của bạn không hỗ trợ phát video.</video>
      <div class="row"><span>Một đoạn video của mình.</span><a href="https://www.tiktok.com/@_1t3_0/video/7693426134591016213" target="_blank" rel="noopener noreferrer">Xem trên TikTok</a></div>
    </section>

    <section class="card contact" aria-labelledby="h-contact">
      <h2 id="h-contact">Làm quen với mình nhé</h2>
      <a class="pill" href="https://www.facebook.com/share/1FW5qvxm1U/?mibextid=wwXIfr" target="_blank" rel="noopener noreferrer">Nhắn trên Facebook</a>
    </section>
  </main>

  <footer>Phan Hoàng Nam · lớp 12A2, THPT Hòn Gai · sinh 03/02/2009</footer>
</div>
</body>
</html>
